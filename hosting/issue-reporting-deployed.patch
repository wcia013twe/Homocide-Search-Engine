+"""A small, optional-description issue form; GitHub owns follow-up status."""
+import json
+import os
+from uuid import uuid4
+
+import streamlit as st
+
+from research_app.issue_reporting import make_report, read_json, report_path, submit_report
+
+
+def render():
+    with st.expander("Submit issue"):
+        st.caption("Report a small UI problem or an error. Tracking and discussion stay in GitHub.")
+        page = st.session_state.get("nav_page", "Search")
+        error = st.session_state.get("issue_last_error")
+        if error:
+            st.caption(f"Recent error: {error['operation']} ({error['error_type']}). Technical details are attached privately.")
+        st.caption("The description will be public on GitHub. Leave out personal or confidential information. Case references and detailed diagnostics stay in Databricks.")
+        with st.form("issue_form", border=False):
+            description = st.text_area("What were you trying to do? (optional)", max_chars=2000,
+                                       placeholder="For example: The source button does not open.", key="issue_description")
+            attach_error = st.checkbox("Attach recent error", value=True, key="issue_attach_error") if error else False
+            clicked = st.form_submit_button("Submit issue", key="issue_submit")
+        if clicked:
+            if not os.environ.get("HR_ISSUE_REPORTER_JOB_ID"):
+                st.error("Issue delivery is not configured yet. No report was sent.")
+                return
+            error = error if attach_error else None
+            draft = json.dumps([page, description, error], sort_keys=True)
+            if st.session_state.get("issue_draft") != draft:
+                st.session_state["issue_draft"] = draft
+                st.session_state["issue_report_id"] = str(uuid4())
+            selected = st.session_state.get("selected_investigation")
+            case_id = (st.session_state.get("case_workspace_id") if page == 'Cases' else
+                       st.session_state.get("investigation_case_id") if page == 'Search' else None)
+            investigation_id = (st.session_state.get('case_investigation_' + case_id) if page == 'Cases' and case_id else
+                                selected.get("id") if page == 'Search' and isinstance(selected, dict) else None)
+            report = make_report(page, description, actor=st.session_state.get("research_user", ""),
+                case_id=case_id,
+                investigation_id=investigation_id, error=error, report_id=st.session_state["issue_report_id"])
+            try:
+                from databricks.sdk import WorkspaceClient
+
+                submit_report(WorkspaceClient(), os.environ["HR_SEARCH_AUDIT_VOLUME"],
+                              os.environ["HR_ISSUE_REPORTER_JOB_ID"], report)
+                st.session_state["issue_submitted_id"] = report['id']
+                st.success("Report saved. GitHub delivery is queued.")
+            except Exception:
+                st.error("Delivery could not be confirmed. Submit again to retry the same report; no research search will run.")
+        report_id = st.session_state.get("issue_submitted_id")
+        if report_id:
+            st.caption("Report " + report_id)
+            if st.button("Get GitHub issue link", key="issue_get_link"):
+                from databricks.sdk import WorkspaceClient
+                from databricks.sdk.errors import NotFound
+
+                try:
+                    receipt = read_json(WorkspaceClient(), report_path(os.environ['HR_SEARCH_AUDIT_VOLUME'], report_id, 'receipts'))
+                    st.session_state["issue_receipt"] = receipt
+                except NotFound:
+                    st.info("The report is saved. GitHub delivery is still pending; check again shortly.")
+                except Exception:
+                    st.error("The delivery link is temporarily unavailable. Your saved report is preserved.")
+            receipt = st.session_state.get("issue_receipt")
+            if receipt and receipt['report_id'] == report_id:
+                st.link_button("Track issue on GitHub", receipt['issue_url'])
