o pending-verification status&lt;br&gt;&lt;br&gt;Catalog: system.ai.ai_decide&lt;br&gt;Present; execution probes failed" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=15;fontColor=#4f5d75;" vertex="1" parent="1"><mxGeometry x="1478" y="426" width="246" height="280" as="geometry"/></mxCell><mxCell id="reject-note" value="reject = skip this pass&lt;br&gt;Retain result for reconsideration" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=13;fontColor=#4f5d75;" vertex="1" parent="1"><mxGeometry x="430" y="545" width="300" height="45" as="geometry"/></mxCell><mxCell id="audit" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f5d75;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="80" y="880" width="1280" height="100" as="geometry"/></mxCell><mxCell id="audit-icon" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%234f5d75%22%20stroke-width%3D%221.7%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cellipse%20cx%3D%2212%22%20cy%3D%225%22%20rx%3D%229%22%20ry%3D%223%22%2F%3E%3Cpath%20d%3D%22M3%205v14c0%204%2018%204%2018%200V5M3%2012c0%204%2018%204%2018%200%22%2F%3E%3C%2Fsvg%3E;" vertex="1" parent="1"><mxGeometry x="98" y="898" width="27" height="27" as="geometry"/></mxCell><mxCell id="audit-title" value="Audit trail / SQLite + saved artifacts" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=18;fontColor=#2d3142;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="137" y="899" width="1210" height="30" as="geometry"/></mxCell><mxCell id="audit-body" value="Record every stage: inputs, source IDs, rubric version, decisions, scores, actions and per-gap search attempts." style="text;html=