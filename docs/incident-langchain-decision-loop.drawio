mxGeometry x="685" y="404" width="44" height="24" as="geometry"/></mxCell><mxCell id="read-extract" value="" style="endArrow=block;endFill=1;html=1;rounded=1;strokeColor=#4f5d75;strokeWidth=1.8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="435" as="sourcePoint"/><mxPoint x="1100" y="435" as="targetPoint"/></mxGeometry></mxCell><mxCell id="extract-resolve" value="" style="endArrow=block;endFill=1;html=1;rounded=1;strokeColor=#4f5d75;strokeWidth=1.8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="520" as="sourcePoint"/><mxPoint x="1230" y="615" as="targetPoint"/></mxGeometry></mxCell><mxCell id="extract-resolve-mask" value="claims" style="text;html=1;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=none;fontFamily=Arial;fontSize=13;fontColor=#4f5d75;" vertex="1" parent="1"><mxGeometry x="1240" y="557" width="58" height="24" as="geometry"/></mxCell><mxCell id="resolve-gaps" value="" style="endArrow=block;endFill=1;html=1;rounded=1;strokeColor=#4f5d75;strokeWidth=1.8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="690" as="sourcePoint"/><mxPoint x="1020" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="resolution-label" value="update" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontColor=#4f5d75;" vertex="1" parent="1"><mxGeometry x="1026" y="657" width="70" height="25" as="geometry"/></mxCell><mxCell id="gaps-control" value="" style="endArrow=block;endFill=1;html=1;rounded=1;strokeColor=#4f5d75;strokeWidth=1.8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="690" as="sourcePoint"/><mxPoint x="680" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="control-stop" value="" style="endArrow=block;endFill=1;html=1;rounded=1;strokeColor=#4f5d75;strokeWidth=1.8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="690" as="sourcePoint"/><mxPoint x="340" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="control-stop-mask" value="stop" style="text;html=1;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=none;fontFamily=Arial;fontSize=13;fontColor=#4f5d75;" vertex="1" parent="1"><mxGeometry x="344" y="654" width="44" height="24" as="geometry"/></mxCell><mxCell id="reject" value="" style="endArrow=block;endFill=1;html=1;rounded=1;strokeColor=#4f5d75;strokeWidth=1.8;dashed=1;dashPattern=5 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="520" as="sourcePoint"/><mxPoint x="550" y="542" as="targetPoint"/></mxGeometry></mxCell><mxCell id="unread" value="" style="endArrow=block;endFill=1;html=1;rounded=1;strokeColor=#4f5d75;strokeWidth=1.8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="615" as="sourcePoint"/><mxPoint x="890" y="520" as="targetPoint"/><Array as="points"><mxPoint x="550" y="590"/><mxPoint x="890" y="590"/></Array></mxGeometry></mxCell><mxCell id="unread-mask" value="useful source still unread" style="text;html=1;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=none;fontFamily=Arial;fontSize=13;fontColor=#4f5d75;" vertex="1" parent="1"><mxGeometry x="637" y="576" width="198" height="24" as="geometry"/></mxCell><mxCell id="new-search" value="" style="endArrow=block;endFill=1;html=1;rounded=1;strokeColor=#4f5d75;strokeWidth=1.8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="770" as="sourcePoint"/><mxPoint x="80" y="435" as="targetPoint"/><Array as="points"><mxPoint x="500" y="825"/><mxPoint x="35" y="825"/><mxPoint x="35" y="435"/></Array></mxGeometry></mxCell><mxCell id="new-search-mask" value="gap + budget: generate query, deduplicate, search_attempts += 1" style="text;html=1;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=none;fontFamily=Arial;fontSize=13;fontColor=#4f5d75;" vertex="1" parent="1"><mxGeometry x="90" y="792" width="457" height="24" as="geometry"/></mxCell><mxCell id="api-a" value="" style="endArrow=block;endFill=1;html=1;rounded=1;strokeColor=#2e5aa8;strokeWidth=1.8;dashed=1;dashPattern=5 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="365" as="sourcePoint"/><mxPoint x="1600" y="365" as="targetPoint"/><Array as="points"><mxPoint x="550" y="255"/><mxPoint x="1600" y="255"/></Array></mxGeometry></mxCell><mxCell id="api-a-mask" value="A: classify leads / return choices" style="text;html=1;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=none;fontFamily=Arial;fontSize=13;fontColor=#2e5aa8;" vertex="1" parent="1"><mxGeometry x="790" y="243" width="254" height="24" as="geometry"/></mxCell><mxCell id="api-b" value="" style="endArrow=block;endFill=1;html=1;rounded=1;strokeColor=#2e5aa8;strokeWidth=1.8;dashed=1;dashPattern=5 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="690" as="sourcePoint"/><mxPoint x="1460" y="580" as="targetPoint"/><Array as="points"><mxPoint x="1410" y="690"/><mxPoint x="1410" y="580"/></Array></mxGeometry></mxCell><mxCell id="api-b-mask" value="B" style="text;html=1;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=none;fontFamily=Arial;fontSize=13;fontColor=#2e5aa8;" vertex="1" parent="1"><mxGeometry x="1378" y="647" width="23" height="24" as="geometry"/></mxCell><mxCell id="audit-note" value="Audit applies to every stage. API failure pauses the pass and records an error; it never becomes a read/reject or fill decision." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=13;fontColor=#4f5d75;" vertex="1" parent="1"><mxGeometry x="80" y="990" width="1550" height="25" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="case-discovery" name="Case discovery method"><mxGraphModel dx="1810" dy="1020" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1810" pageHeight="1020" background="#f5f5f5" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="e1" parent="1" source="find" target="save" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4f5d75;strokeWidth=1.8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" parent="1" source="save" target="queries" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4f5d75;strokeWidth=1.8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" parent="1" source="queries" target="loop" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4f5d75;strokeWidth=1.8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="title" parent="1" value="Case discovery: find enough to start the incident loop" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=32;fontColor=#2d3142;fontStyle=1;" vertex="1"><mxGeometry as="geometry" x="65" y="35" width="1680" height="55" /></mxCell><mxCell id="subtitle" parent="1" value="Discovery produces a small, source-backed candidate record. The incident loop investigates and verifies the case." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=20;fontColor=#4f5d75;fontStyle=0;" vertex="1"><mxGeometry as="geometry" x="65" y="100" width="1680" height="45" /></mxCell><mxCell id="discovery-label" parent="1" value="DISCOVERY  /  Find and save identifying anchors" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=18;fontColor=#4f5d75;fontStyle=1;" vertex="1"><mxGeometry as="geometry" x="80" y="195" width="880" height="35" /></mxCell><mxCell id="loop-label" parent="1" value="INCIDENT LOOP  /  Read the saved candidate" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=18;fontColor=#4f5d75;fontStyle=1;" vertex="1"><mxGeometry as="geometry" x="1030" y="195" width="700" height="35" /></mxCell><mxCell id="find" parent="1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f5d75;strokeWidth=1.5;" vertex="1"><mxGeometry as="geometry" x="80" y="260" width="340" height="310" /></mxCell><mxCell id="find-title" parent="1" value="1  Find a possible case" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=22;fontColor=#2d3142;fontStyle=1;" vertex="1"><mxGeometry as="geometry" x="102" y="282" width="296" height="40" /></mxCell><mxCell id="find-body" parent="1" value="Search news or records by&lt;br&gt;place + period + event terms.&lt;br&gt;&lt;br&gt;Extract any useful identifying&lt;br&gt;details from a source." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=19;fontColor=#4f5d75;fontStyle=0;" vertex="1"><mxGeometry as="geometry" x="102" y="348" width="296" height="210" /></mxCell><mxCell id="save" parent="1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8e9e3;strokeColor=#bf4520;strokeWidth=1.5;" vertex="1"><mxGeometry as="geometry" x="490" y="260" width="470" height="310" /></mxCell><mxCell id="save-title" parent="1" value="2  Save the candidate" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=22;fontColor=#2d3142;fontStyle=1;" vertex="1"><mxGeometry as="geometry" x="512" y="282" width="426" height="40" /></mxCell><mxCell id="save-body" parent="1" value="Candidate ID: stable internal identifier&lt;br&gt;Identifying details: as found in source&lt;br&gt;Source reference: URL or archive ID&lt;br&gt;Supporting excerpt: evidence for details&lt;br&gt;&lt;br&gt;Keep missing / uncertain details explicit." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=19;fontColor=#4f5d75;fontStyle=0;" vertex="1"><mxGeometry as="geometry" x="512" y="348" width="426" height="210" /></mxCell><mxCell id="queries" parent="1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f5d75;strokeWidth=1.5;" vertex="1"><mxGeometry as="geometry" x="1030" y="260" width="300" height="310" /></mxCell><mxCell id="queries-title" parent="1" value="3  Generate queries" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=22;fontColor=#2d3142;fontStyle=1;" vertex="1"><mxGeometry as="geometry" x="1052" y="282" width="256" height="40" /></mxCell><mxCell id="queries-body" parent="1" value="Read the candidate record.&lt;br&gt;Combine available anchors&lt;br&gt;into focused case queries.&lt;br&gt;&lt;br&gt;Save searches in loop audit." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=19;fontColor=#4f5d75;fontStyle=0;" vertex="1"><mxGeometry as="geometry" x="1052" y="348" width="256" height="210" /></mxCell><mxCell id="loop" parent="1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f5d75;strokeWidth=1.5;" vertex="1" link="data:page/id,incident-loop"><mxGeometry as="geometry" x="1400" y="260" width="330" height="310" /></mxCell><mxCell id="loop-title" parent="1" value="4  Investigate the case" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=22;fontColor=#2d3142;fontStyle=1;" vertex="1"><mxGeometry as="geometry" x="1422" y="282" width="286" height="40" /></mxCell><mxCell id="loop-body" parent="1" value="Run searches and read sources.&lt;br&gt;Verify identity and incident.&lt;br&gt;Collect and resolve claims.&lt;br&gt;&lt;br&gt;Continue on page 1." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=19;fontColor=#4f5d75;fontStyle=0;" vertex="1"><mxGeometry as="geometry" x="1422" y="348" width="286" height="210" /></mxCell><mxCell id="anchors" parent="1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f5d75;strokeWidth=1.5;" vertex="1"><mxGeometry as="geometry" x="80" y="660" width="790" height="210" /></mxCell><mxCell id="anchors-title" parent="1" value="Enough to begin: examples of useful anchors" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=22;fontColor=#2d3142;fontStyle=1;" vertex="1"><mxGeometry as="geometry" x="102" y="682" width="746" height="40" /></mxCell><mxCell id="anchors-body" parent="1" value="Victim name + city  |  Date + location  |  Agency + case number&lt;br&gt;Unnamed victim + discovery date + address / circumstances&lt;br&gt;&lt;br&gt;Use whichever combination supports a focused follow-up search." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=19;fontColor=#4f5d75;fontStyle=0;" vertex="1"><mxGeometry as="geometry" x="102" y="748" width="746" height="110" /></mxCell><mxCell id="purpose" parent="1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f5d75;strokeWidth=1.5;" vertex="1"><mxGeometry as="geometry" x="940" y="660" width="790" height="210" /></mxCell><mxCell id="purpose-title" parent="1" value="Why save the record before generating queries?" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=22;fontColor=#2d3142;fontStyle=1;" vertex="1"><mxGeometry as="geometry" x="962" y="682" width="746" height="40" /></mxCell><mxCell id="purpose-body" parent="1" value="It preserves what was found and the evidence behind the queries.&lt;br&gt;The loop can reuse the details, add findings and avoid losing context.&lt;br&gt;&lt;br&gt;Official case numbers and a fully coded incident are not required." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=19;fontColor=#4f5d75;fontStyle=0;" vertex="1"><mxGeometry as="geometry" x="962" y="748" width="746" height="110" /></mxCell><mxCell id="footer" parent="1" value="Discovery finds a lead. Verification and detailed coding happen in the incident loop. Dataset coverage is assessed separately." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=19;fontColor=#2d3142;fontStyle=1;" vertex="1"><mxGeometry as="geometry" x="80" y="925" width="1650" height="50" /></mxCell></root></mxGraphModel></diagram></mxfile>